import { SelectionManager } from './selection-manager.js';
import { GAME_CONFIG } from './game-config.js';

// Мокаем зависимости
jest.mock('./wasm-imports.js');
jest.mock('./game-config.js');
jest.mock('./selection-indicator.js');
jest.mock('./entity-service.js');
jest.mock('./utils.js');

// Мокаем GAME_CONFIG
GAME_CONFIG.LIMITS = { maxGroupSize: 12 };

describe('SelectionManager - Additional Tests', () => {
  let selectionManager;
  let mockGameDemo;

  beforeEach(() => {
    // Создаем мок для gameDemo
    mockGameDemo = {
      stateManager: {
        getSelectionState: jest.fn(),
        updateSelectionState: jest.fn(),
        getEntityState: jest.fn(),
      },
      entityRenderer: {
        clearTargetIndicator: jest.fn(),
      },
      updateStatus: jest.fn(),
      updateEntityInfo: jest.fn(),
      updateSpawnButtonState: jest.fn(),
      displayEntityInfo: jest.fn(),
      app: {
        stage: {
          removeChild: jest.fn(),
        },
      },
      entities: new Map(),
    };

    // Создаем экземпляр SelectionManager
    selectionManager = new SelectionManager(mockGameDemo);
    
    // Мокаем методы SelectionManager
    selectionManager.isSelecting = false;
    selectionManager._updateLocalSelectionState = jest.fn();
    selectionManager.selectionIndicatorManager = {
      updateSelectionIndicators: jest.fn(),
      removeSelectionIndicator: jest.fn()
    };
    
    // Мокаем SelectionIndicatorManager в gameDemo
    mockGameDemo.selectionIndicatorManager = selectionManager.selectionIndicatorManager;
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  describe('_updateLocalSelectionState', () => {
    test('должен обновлять локальное состояние выбора', () => {
      // Мокаем состояние выбора
      mockGameDemo.stateManager.getSelectionState.mockReturnValue({
        selectedEntityIds: new Set([1, 2]),
      });
      
      const selectionResult = {
        selected_entities: [2, 3, 4]
      };

      // Вызываем метод
      selectionManager._updateLocalSelectionState(selectionResult);
      
      // Проверяем, что метод updateSelectionIndicators был вызван
      // Для этого нужно проверить, что selectionIndicatorManager существует и был вызван
      expect(selectionManager.selectionIndicatorManager).toBeDefined();
      expect(selectionManager.selectionIndicatorManager.updateSelectionIndicators).toHaveBeenCalledWith(new Set([2, 3, 4]));
    });
  });

  describe('selectEntitiesInRectangle', () => {
    test('должен выбрать сущности в прямоугольнике', async () => {
      // Мокаем флаг isSelecting
      selectionManager.isSelecting = false;
      
      // Мокаем метод _findEntitiesInRectangle
      selectionManager._findEntitiesInRectangle = jest.fn().mockReturnValue([1, 2]);
      
      // Мокаем метод _processRectangleSelection
      selectionManager._processRectangleSelection = jest.fn();

      // Вызываем метод
      await selectionManager.selectEntitiesInRectangle({});
      
      // Проверяем, что методы были вызваны
      expect(selectionManager._findEntitiesInRectangle).toHaveBeenCalledWith({});
      expect(selectionManager._processRectangleSelection).toHaveBeenCalledWith([1, 2]);
    });

    test('не должен ничего делать, если уже идет выбор', async () => {
      // Мокаем флаг isSelecting
      selectionManager.isSelecting = true;
      
      // Мокаем метод _findEntitiesInRectangle
      selectionManager._findEntitiesInRectangle = jest.fn();
      
      // Вызываем метод
      await selectionManager.selectEntitiesInRectangle({});
      
      // Проверяем, что метод не был вызван
      expect(selectionManager._findEntitiesInRectangle).not.toHaveBeenCalled();
    });
  });

  describe('_findEntitiesInRectangle', () => {
    test('должен находить сущности в прямоугольнике', () => {
      // Создаем тестовые сущности
      const entity1 = { id: 1, container: { x: 50, y: 50 } };
      const entity2 = { id: 2, container: { x: 150, y: 150 } };
      const entity3 = { id: 3, container: { x: 250, y: 250 } };
      
      // Добавляем сущности в gameDemo.entities
      mockGameDemo.entities.set(1, entity1);
      mockGameDemo.entities.set(2, entity2);
      mockGameDemo.entities.set(3, entity3);
      
      // Определяем границы прямоугольника
      const bounds = { x: 0, y: 0, width: 200, height: 200 };

      // Вызываем метод
      const result = selectionManager._findEntitiesInRectangle(bounds);
      
      // Проверяем результат
      expect(result).toEqual([1, 2]);
    });
  });

  describe('selectAllPlayerUnits', () => {
    test('должен выбрать всех подвижных юнитов игрока', async () => {
      // Мокаем метод clearAllSelections
      selectionManager.clearAllSelections = jest.fn();
      
      // Мокаем состояние сущностей
      mockGameDemo.stateManager.getEntityState.mockReturnValue({
        entities: new Map([
          [1, { id: 1, fraction: 'Player', entityType: 'vehicle' }],
          [2, { id: 2, fraction: 'Player', entityType: 'vehicle' }],
          [3, { id: 3, fraction: 'Enemy', entityType: 'vehicle' }]
        ])
      });
      
      // Мокаем метод _performEntitySelection
      selectionManager._performEntitySelection = jest.fn().mockResolvedValue({
        success: true
      });
      
      // Мокаем GAME_CONFIG
      GAME_CONFIG.LIMITS = { maxGroupSize: 12 };

      // Вызываем метод
      await selectionManager.selectAllPlayerUnits();
      
      // Проверяем, что методы были вызваны
      expect(selectionManager.clearAllSelections).toHaveBeenCalledWith(true);
      expect(selectionManager._performEntitySelection).toHaveBeenCalledTimes(2);
    });
  });

  describe('selectSameTypeUnits', () => {
    test('должен выбрать всех юнитов того же типа', () => {
      // Мокаем метод clearAllSelections
      selectionManager.clearAllSelections = jest.fn();
      
      // Мокаем метод selectEntity
      selectionManager.selectEntity = jest.fn().mockReturnValue(true);
      
      // Мокаем состояние сущностей
      mockGameDemo.stateManager.getEntityState.mockReturnValue({
        entities: new Map([
          [1, { id: 1, fraction: 'Player', entityType: 'vehicle', vehicleType: 'scout' }],
          [2, { id: 2, fraction: 'Player', entityType: 'vehicle', vehicleType: 'scout' }],
          [3, { id: 3, fraction: 'Player', entityType: 'vehicle', vehicleType: 'tank' }]
        ])
      });
      
      // Мокаем состояние выбора
      const mockSelectionState = {
        selectedEntityIds: new Set()
      };
      mockGameDemo.stateManager.getSelectionState.mockReturnValue(mockSelectionState);
      
      // Мокаем GAME_CONFIG
      GAME_CONFIG.LIMITS = { maxGroupSize: 12 };

      // Вызываем метод
      selectionManager.selectSameTypeUnits(1);
      
      // Проверяем, что методы были вызваны
      expect(selectionManager.clearAllSelections).toHaveBeenCalledWith(true);
      // Проверяем, что selectEntity был вызван 2 раза (для сущностей 1 и 2)
      // Но сначала он вызывается для сущности 1, потом для сущности 2
      expect(selectionManager.selectEntity).toHaveBeenCalledWith(1, true, false);
      expect(selectionManager.selectEntity).toHaveBeenCalledWith(2, true, false);
    });
  });
});