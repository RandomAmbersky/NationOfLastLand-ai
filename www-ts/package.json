{
  "name": "nation-of-last-land-ts",
  "version": "0.1.0",
  "description": "Nation of Last Land - TypeScript version with Pixi.js rendering",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "build:watch": "tsc -p . --watch",
    "dev": "npm run build && concurrently \"npm run build:watch\" \"npx serve dist -l 3001\"",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pixi.js": "^7.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.0",
    "typescript": "^5.0.0",
    "ts-jest": "^29.0.0",
    "concurrently": "^8.0.0"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "rust",
    "pixi.js",
    "game",
    "typescript"
  ],
  "author": "Nation of Last Land Team",
  "license": "MIT"
}
