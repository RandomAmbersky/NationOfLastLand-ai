{
  "name": "nation-of-last-land-demo",
  "version": "0.1.0",
  "description": "WebAssembly demo for Nation of Last Land game with Pixi.js rendering",
  "main": "www/app.js",
  "type": "module",
  "jest": {
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^./wasm-imports\\.js$": "<rootDir>/www/__mocks__/wasm-imports.js"
    }
  },
  "scripts": {
    "build": "wasm-pack build --target web --out-dir www/pkg --dev",
    "build-release": "wasm-pack build --target web --out-dir www/pkg --release",
    "serve": "npx serve www -l 3000",
    "dev": "npm run build && npm run serve",
    "clean": "rm -rf www/pkg target/pkg",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:ts": "tsc -p www-ts/tsconfig.json",
    "dev:ts": "npm run build:ts && concurrently \"npm run build:ts:watch\" \"npx serve www -l 3002\"",
    "build:ts:watch": "tsc -p www-ts/tsconfig.json --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pixi.js": "^7.3.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-standard": "^5.0.0",
    "express": "^4.18.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "serve": "^14.2.1",
    "standard": "^17.1.2",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "rust",
    "pixi.js",
    "game",
    "demo"
  ],
  "author": "Nation of Last Land Team",
  "license": "MIT"
}
