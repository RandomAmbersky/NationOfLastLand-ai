{
  "extends": "standard",
  "env": {
    "node": true,
    "jest": true
  },
  "globals": {
    "describe": "readonly",
    "it": "readonly",
    "expect": "readonly",
    "beforeEach": "readonly",
    "jest": "readonly",
    "PIXI": "readonly",
    "requestAnimationFrame": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "camelcase": "off"
  }
}
