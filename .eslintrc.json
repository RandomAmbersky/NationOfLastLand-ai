{
  "extends": "standard",
  "env": {
    "node": true,
    "jest": true
  },
  "globals": {
    "describe": "readonly",
    "it": "readonly",
    "expect": "readonly",
    "beforeEach": "readonly",
    "jest": "readonly",
    "PIXI": "readonly",
    "requestAnimationFrame": "readonly"
  },
  "rules": {
    "space-before-function-paren": [
      "error",
      {
        "anonymous": "always",
        "named": "always",
        "asyncArrow": "always"
      }
    ]
  }
}
